# WorkOS AuthKit server configuration.
# Keep real values out of source control.
WORKOS_API_KEY=sk_test_replace_me
WORKOS_CLIENT_ID=client_replace_me
WORKOS_ORGANIZATION_ID=org_replace_me
WORKOS_REDIRECT_URI=http://127.0.0.1:3080/auth/callback
WORKOS_COOKIE_SECRET=replace_with_at_least_32_random_characters

# Optional encrypted management-config paths. Defaults are under $DSH_HOME.
# DSH_TENANT_CONFIG_FILE=/absolute/path/workos-tenant-config.json
# DSH_TENANT_CONFIG_KEY_FILE=/absolute/path/workos-tenant-config.json.key

# Optional Cloudflare D1 persistence. Omit these for local JSON storage.
# DSH_TENANT_STORAGE=d1
# CLOUDFLARE_ACCOUNT_ID=replace_me
# CLOUDFLARE_D1_DATABASE_ID=replace_me
# CLOUDFLARE_API_TOKEN=replace_me
# DSH_TENANT_ENCRYPTION_KEY=replace_with_at_least_32_random_characters
